{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/nightward", "destination": "/nightward/index.html" },
    { "source": "/nightward/", "destination": "/nightward/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
