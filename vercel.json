{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/m/:lat(-?[0-9]{1,2}[.][0-9]{1,7})/:lng(-?[0-9]{1,3}[.][0-9]{1,7})",
      "destination": "https://map.kakao.com/link/map/%EC%95%BD%EC%86%8D%20%EC%9E%A5%EC%86%8C,:lat,:lng",
      "permanent": false
    },
    {
      "source": "/dangmasil/privacy",
      "destination": "https://dangmasil.lunenlabs.com/privacy",
      "permanent": true
    },
    {
      "source": "/dangmasil",
      "destination": "https://dangmasil.lunenlabs.com/",
      "permanent": true
    },
    {
      "source": "/dangmasil/",
      "destination": "https://dangmasil.lunenlabs.com/",
      "permanent": true
    },
    {
      "source": "/dangmasil/index.html",
      "destination": "https://dangmasil.lunenlabs.com/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!api/|assets/|dangmasil/).*)",
      "has": [
        {
          "type": "host",
          "value": "dangmasil.lunenlabs.com"
        }
      ],
      "destination": "/dangmasil/index.html"
    },
    {
      "source": "/:path((?!api/|assets/|poljjak/).*)",
      "has": [
        {
          "type": "host",
          "value": "poljjak.lunenlabs.com"
        }
      ],
      "destination": "/poljjak/index.html"
    },
    {
      "source": "/nightward",
      "destination": "/nightward/index.html"
    },
    {
      "source": "/nightward/",
      "destination": "/nightward/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
